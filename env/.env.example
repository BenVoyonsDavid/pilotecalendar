# HoraireTeams v1.0.0 - production template
NODE_ENV=production
PORT=3978

# Microsoft Entra / Teams bot identity
CLIENT_ID=00000000-0000-0000-0000-000000000000
CLIENT_SECRET=replace-me
TENANT_ID=00000000-0000-0000-0000-000000000000

# Public HTTPS host, without https://
PUBLIC_DOMAIN=app.example.com
APPLICATION_ID_URI=api://app.example.com/00000000-0000-0000-0000-000000000000

# API authentication. Production must use entra.
AUTH_MODE=entra

# Development escape hatch only. Ignored when NODE_ENV=production.
TEAMS_ALLOW_UNAUTHENTICATED=false
