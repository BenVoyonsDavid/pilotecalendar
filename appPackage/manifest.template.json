{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.30/MicrosoftTeams.schema.json",
  "manifestVersion": "1.30",
  "version": "1.0.2",
  "id": "__TEAMS_APP_ID__",
  "packageName": "ca.pilotecalendar.app",
  "developer": {
    "name": "PiloteCalendar",
    "websiteUrl": "https://__PUBLIC_DOMAIN__",
    "privacyUrl": "https://__PUBLIC_DOMAIN__/privacy.html",
    "termsOfUseUrl": "https://__PUBLIC_DOMAIN__/terms.html"
  },
  "name": {
    "short": "PiloteCalendar",
    "full": "PiloteCalendar – Horaire d’équipe"
  },
  "description": {
    "short": "Planifiez les horaires, affectations, absences et télétravail dans Teams.",
    "full": "PiloteCalendar permet de gérer les horaires d’équipe, les affectations, les absences, les vacances, le télétravail, les règles de couverture et les notifications Microsoft Teams."
  },
  "icons": {
    "outline": "outline.png",
    "color": "color.png"
  },
  "accentColor": "#5B5FC7",
  "staticTabs": [
    {
      "entityId": "pilotecalendar-home",
      "name": "PiloteCalendar",
      "contentUrl": "https://__PUBLIC_DOMAIN__/",
      "websiteUrl": "https://__PUBLIC_DOMAIN__/",
      "scopes": [
        "personal",
        "team"
      ],
      "context": [
        "personalTab",
        "channelTab"
      ]
    }
  ],
  "bots": [
    {
      "botId": "__CLIENT_ID__",
      "scopes": [
        "personal",
        "team",
        "groupChat"
      ],
      "isNotificationOnly": false,
      "supportsFiles": false
    }
  ],
  "permissions": [
    "identity"
  ],
  "supportsChannelFeatures": "tier1",
  "validDomains": [
    "__PUBLIC_DOMAIN__",
    "token.botframework.com"
  ],
  "webApplicationInfo": {
    "id": "__CLIENT_ID__",
    "resource": "api://__PUBLIC_DOMAIN__/__CLIENT_ID__"
  }
}
